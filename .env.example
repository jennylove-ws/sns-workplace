# Remotion Superpowers — service API keys
# Copy this file to .env and fill in the keys you have. .env is gitignored.

# Required — music, SFX, TTS, images, video, subtitles (https://kie.ai)
KIE_API_KEY=

# Recommended — video understanding / analysis (https://www.twelvelabs.io)
TWELVELABS_API_KEY=

# Recommended, free — stock photos & videos (https://www.pexels.com/api/)
PEXELS_API_KEY=

# Optional — voice cloning & custom voices (https://elevenlabs.io)
ELEVENLABS_API_KEY=

# Optional — extra AI image/video models (https://replicate.com)
REPLICATE_API_TOKEN=
